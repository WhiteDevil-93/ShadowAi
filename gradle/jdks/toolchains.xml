<?xml version="1.0" encoding="UTF-8"?>
<toolchains>
  <!-- JDK 21 for all builds -->
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>21</version>
      <vendor>any</vendor>
    </provides>
    <configuration>
      <jdkHome>/home/anon3/.jdks/jdk-21</jdkHome>
    </configuration>
  </toolchain>
  <!-- JDK 17 for specific modules -->
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>17</version>
      <vendor>any</vendor>
    </provides>
    <configuration>
      <jdkHome>/home/anon3/.jdks/jdk-17</jdkHome>
    </configuration>
  </toolchain>
</toolchains>