<?xml version="1.0" encoding="utf-8"?>
<!--
  Production Network Security Configuration
  - L-3: Certificate pinning for all cloud AI providers
  - Prevents MITM attacks by pinning SSL certificates
  - TODO: Before release, add real backup pins from alternate CAs
    (obtain with: openssl s_client -connect <domain>:443 | openssl x509 -pubkey | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64)
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Base configuration blocks cleartext traffic for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug/Local development domains (cleartext allowed) -->
    <!-- NOTE: 10.0.2.2 is emulator-only; cleartext for it lives in src/debug/ overlay -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain>127.0.0.1</domain>
    </domain-config>

    <!-- OpenAI API - Certificate Pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain>api.openai.com</domain>
        <pin-set
            expiration="2030-01-01"
            tools:ignore="MissingBackupPin">
            <pin digest="SHA-256">y5npFVdBuoqCSOdQa42qiUSPqwMpoei7NK0rQWGUaSU=</pin>
            <!-- TODO: Add real backup pin from alternate CA before production release -->
        </pin-set>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

